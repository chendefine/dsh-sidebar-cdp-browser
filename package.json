{
  "name": "dsh-sidebar-cdp-browser",
  "version": "0.1.1",
  "description": "DSH better-sidebar plugin for secure Chromium CDP live viewing and control.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chendefine/dsh-sidebar-cdp-browser.git"
  },
  "bugs": {
    "url": "https://github.com/chendefine/dsh-sidebar-cdp-browser/issues"
  },
  "homepage": "https://github.com/chendefine/dsh-sidebar-cdp-browser#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "better-sidebar",
    "cdp",
    "chromium",
    "puppeteer",
    "screencast",
    "remote-control"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "cordis": "^4.0.0-rc.7",
    "dsh-better-sidebar": ">=0.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "puppeteer-core": "^24.10.2",
    "schemastery": "^3.18.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.5.10",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
